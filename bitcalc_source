#!/usr/bin/bash

set -euo pipefail

FROM_BASE=""
TO_BASE="dec"
WIDTH=8
PRECISION=8
VERBOSE=1
QUIET=0
INTERACTIVE=0

BOLD="\033[1m"
GREEN="\033[32m"
CYAN="\033[36m"
YELLOW="\033[33m"
RED="\033[31m"
RESET="\033[0m"

rational_re="^[0-9]+\.[0-9]+$"
neg_re="^-[0-9]+$"
neg_rational_re="^-[0-9]+\.[0-9]+$"

error_exit() {
	echo -e "${RED}Error:${RESET} $1" >&2
	exit 1
}

usage() {
	cat << 'EOF'
BITCALC(1)			User Commands			BITCALC(1)

NAME
	bitcalc - Bitwise operations and base conversions utility

SYNOPSIS
	bitcalc [FLAGS] <NUMBER>
	bitcalc [FLAGS] <NUMBER> <OPERATOR> <NUMBER>
	bitcalc [FLAGS] NOT <NUMBER>
	echo "<EXPRESSION>" | bitcalc [FLAGS]
	bitcalc -i | --interactive

DESCRIPTION
	bitcalc is a hardware engineerng toolkit for executing binary arithmetic, base conversions, and step-by-step bitwise visualizations.

FLAGS:
	-f, --from <base> 	Input base: bin (2), oct (8), dec (10), hex (16)
	-t, --to <base>   	Output base: bin (2), oct (8), dec (10), hex (16), bcd, gray
	-w, --width <bits>	Set register bit-width (8, 16, 32, 64) for bounds and padding. Default: 8
	--prec <bits>		Precision depth for fractional binary converstion. Default: 8
	-q, --quiet	  	Output only the final value (ideal for scripting)
	-i, --interactive	Launch the REPL interactive shell
	-h, --help	  	Display this help manual

OPERATORS:
	Binary Math:		ADD, SUB, MUL, DIV
	Bitwise Logic:		AND, OR, XOR, NOT, LSHIFT, RSHIFT
	MCU Manipulation:	ROLL, ROR
	Unary Operations: 	NOT, 1COMP, 2COMP, BSWAP, POPCNT

EXAMPLES:
	bitcalc --from hex --to bin 85
	bitcalc 10 AND 12
	bitcalc -v 0b1010 XOR 0b1100
	bitcalc NOT 0b10101011 --pad 8
	bitcalc -w 8 --to twos_comp -10
	bitcalc -w 8 0b010000001 ROL 1
	bitcalc -w 16 0xABCD BSWAP
	bitcalc 0b10110110 POPCNT
	bitcalc -v 0b1011 ADD 0b0110bitcalc 10 LSHIFT 2 | bitcalc -t hex
EOF
}

validate_input() {
	local val="$1" base="$2"

	case "$base" in
		bin|2)	[[ "$val" =~ ^[01]+(\.[01]+)?$ ]] || error_exit "'$val' contains invalid binary digits. Expected only 0 or 1." ;;
		oct|8)	[[ "$val" =~ ^[0-7]+$ ]] || error_exit "'$val' contains invalid octal digits. Expected 0-7." ;;
		hex|16)	[[ "$val" =~ ^[0-9a-fA-F]+$ ]] || error_exit "'$val' contains invalid hexadecimal digits. Expected 1-9 and / or A-F." ;;
		dec|10)	[[ "$val" =~ ^-?[0-9]+(\.[0-9]+)?$ ]] || error_exit "'$val' contains invalid decimal digits. Expected only 1-9." ;;
	esac
}

parse_to_dec() {
	local val="$1"
	local base_hint="$FROM_BASE"

	if [[ -z "$base_hint" ]]; then
		if [[ "$val" =~ ^0[bB][01]+$ ]]; then
			val="${val:2}"
			base_hint="bin"
		elif [[ "$val" =~ ^0[xX][0-9a-fA-F]+$ ]]; then
			val="${val:2}"
			base_hint="hex"
		elif [[ "$val" =~ ^0[oO][0-7]+$ ]]; then
			val="${val:2}"
			base_hint="oct"
		else
			base_hint="dec"
		fi
	fi

	validate_input "$val" "$base_hint"

	case "$base_hint" in
		bin|2)	echo "$((2#$val))" ;;
		oct|8)	echo "$((8#$val))" ;;
		hex|16)	echo "$((16#$val))" ;;
		dec|10)	echo "$val" ;;
	esac
}

dec_to_bin() {
	local val=$1 pad=$2 res=""

	if [ "$val" -eq 0 ]; then
		res="0"
	else
		while [ "$val" -gt 0 ]; do
			res="$(( val & 1 ))$res"
			val=$(( val >> 1 ))
		done
	fi
	printf "%0${pad}d\n" "${res:-0}"
}

dec_to_bin_frac() {
	local frac_str="$1" prec="$2"
	local len="${#frac_str}"
	local scale=$(( 10 ** len ))
	local val=$(( 10#$frac_str )) res=""

	for (( i=0; i<prec; i++ )); do
		val=$(( val * 2 ))
		if [[ $val -ge $scale ]]; then
			res="${res}1"
			val=$(( val - scale ))
		else
			res="${res}0"
		fi
		[[ $val -eq 0 ]] && break
	done
	echo "$res"
}

int_frac_sep() {
	echo "$(dec_to_bin "${1%.*}" "$WIDTH").$(dec_to_bin_frac "${1#*.}" "$PRECISION")"
}

carry() {
	local a="$1" b="$2" 
	local carry=0 carry_str=" "
	for (( i=0; i<WIDTH; i++ )); do
		local ba=$(( (a >> i) & 1 ))
		local bb=$(( (b >> i) & 1 ))
		[[ $carry -eq 1 ]] && carry_str="1${carry_str}" || carry_str=" ${carry_str}"
		carry=$(( (ba & bb) | (carry & (ba ^ bb)) ))
	done
	[[ $carry -eq 1 ]] && echo "1${carry_str}" || echo "${carry_str}"
}

twos_comp() {
	local num="$1"
	local mask=$(( (1 << WIDTH) - 1 ))
	echo $(( num < 0 ? (((~(-num)) + 1) & mask) : num ))
}

x_shift() {
	local a="$1" b="$2" v_shift="$3"
	local n_b=$((b < 0 ? -b : b))
	[[ $n_b -ge $WIDTH ]] && error_exit "Shift exceeds width."

	local mask=$(( (1 << WIDTH) - 1 ))
	if [[ "$v_shift" == "LSHIFT" ]]; then
		echo $(( (b < 0 ? (a >> n_b) : (a << n_b)) & mask ))
	else
		echo $(( (b < 0 ? (a << n_b) : (a >> n_b)) & mask ))
	fi
}

x_ro() {
	local a="$1" b="$2" v_rol="$3"
	local n_b=$(( (b < 0 ? -b : b) % WIDTH ))
	local mask=$(( (1 << WIDTH) - 1 ))

	local rol=$(( ((a << n_b ) | (a >> (WIDTH - n_b))) & mask ))
	local ror=$(( ((a >> n_b ) | (a << (WIDTH - n_b))) & mask ))

	if [[ "$v_rol" == "ROL" ]]; then
		echo $(( b < 0 ? ror : rol ))
	else
		echo $(( b < 0 ? rol : ror ))
	fi
}


to_bcd() {
	local dec_str="$1" bcd_out=""
	for (( i=0; i<${#dec_str}; i++ )); do
		local digit="${dec_str:$i:1}"
		bcd_out="${bcd_out}$(dec_to_bin "$digit" 4) "
	done
	echo "${bcd_out% }"
}

bin_to_gray() {
	echo "$(( $1 ^ ($1 >> 1) ))"
}

popcount() {
	local n=$1 count=0
	while [ "$n" -gt 0 ]; do
		count=$(( count + (n & 1) ))
		n=$(( n >> 1 ))
	done
	echo "$count"
}

bswap() {
	local val=$1
	local w=$WIDTH
	case $w in
		16) echo "$(( ((val & 0xFF) << 8) | ((val >> 8) & 0xFF) ))" ;;
		32) echo "$(( ((val &0xFF) << 24) | (((val >> 8) & 0xFF) << 16) | (((val >> 16) & 0xFF) << 8) | ((val >> 24) & 0xFF) ))" ;;
		*) error_exit "BSWAP requires --width 16 or 32." ;;
	esac
}

format_output() {
	local result="$1"
	local dec_val=$result
	case "$TO_BASE" in
		bin|2)	printf "0b%s\n" $(dec_to_bin "$dec_val" "$WIDTH") ;;
		hex|16)	printf "0x%X\n" "$dec_val" ;;
		oct|8)	printf "0o%o\n" "$dec_val" ;;
		bcd)	printf "%s " $(to_bcd "$dec_val") ;;
		gray)	printf "0b%s\n" $(dec_to_bin "$(bin_to_gray "$dec_val")" "$WIDTH") ;;
		*)	printf "%d\n" "$dec_val" ;;
	esac
}

print_binary_add() {
	local a=$1 b=$2 res=$3 mask=$4 op=$5 symbol=$6
	n_res=$(( res & mask ))

	if [[ "$op" == "ADD" ]]; then
		printf "%-14s %b\n" "carry" "${CYAN}$(carry "$a" "$b")${RESET}"
	fi

	printf "%-14s= %b\n" "$a" "${CYAN}$(dec_to_bin "$(twos_comp "$a")" "$WIDTH")${RESET}"
	printf "%-14s= %b\n" "$b" "${CYAN}$(dec_to_bin "$(twos_comp "$b")" "$WIDTH")${RESET}"
	printf "%-14s= %b\n" "" "${BOLD}${symbol}${RESET}"
	echo -e "..................................."
	printf "%-14s= %b\n" "${a}${op}${b}" "${GREEN}$(dec_to_bin "$n_res" "$WIDTH")($n_res)${RESET}"
	printf "%-14s= %b\n" "ans_dec" "${GREEN}$res${RESET}"
}

print_unary_verbose() {
	local num_raw=$1 op="$2" num="$3" result="$4"
	local mask=$(( (1 << WIDTH) - 1 ))

	if [[ $num =~ $neg_re && "$op" == "2COMP" ]]; then
		local abs_num=$(( -num ))
		local comp1_dec=$(( (~abs_num) & mask ))

		echo -e "${CYAN}${num_raw}${RESET}"
		printf "${CYAN}%-14s${RESET}-> %b\n" "${abs_num}" "$(dec_to_bin "$abs_num" "$WIDTH")"
		echo -e "..................................."
		printf "%-14s %b\n" "carry:" "${CYAN}$(carry "$comp1_dec" 1)${RESET}"
		printf "%-14s-> %b\n" "1comp" "${CYAN}$(dec_to_bin "$comp1_dec" "$WIDTH")${RESET}"
		printf "%-14s %b\n" "" "+ $(printf "%${WIDTH}s" "1")"
		echo -e "..................................."
		printf "%-14s %b\n" "2comp" "${num_raw}	-> ${GREEN}$(dec_to_bin "$res" "$WIDTH")${RESET}"
	else
		printf "${CYAN}%-14s${RESET} %b\n" "${num_raw}" "$(dec_to_bin "$(twos_comp "$num")" "$WIDTH")"
		echo -e ".............................."
		if [[ "$op" == "POPCNT" ]]; then
			printf "${BOLD}%-14s${RESET}-> %b\n" "${op}" "number of 1s=${GREEN}${res}${RESET}"
		else
			printf "${BOLD}%-14s${RESET}-> %b\n" "${op}" "${GREEN}$(dec_to_bin "$res" "$WIDTH")${RESET}($res)"
		fi
	fi
}

evaluate_math() {
	local args=("$@")
	local len=${#args[@]}
	local mask=$(( (1 << WIDTH) - 1 ))
	local res=0

	if [[ $len -eq 1 ]]; then
		local num_raw="${args[0]}"
		if [[ "$num_raw" =~ $neg_re ]]; then
			res=$(twos_comp "$num_raw")
			[[ $QUIET -eq 0 && $VERBOSE -eq 1 ]] && print_unary_verbose "$num_raw" "2COMP" "$num_raw" "$res"
		else
			res=$(parse_to_dec "$num_raw")
		fi
	elif [[ $len -eq 2 ]]; then
		local op="${args[0]^^}" num_raw="${args[1]}"
		local num=$(parse_to_dec "$num_raw")

		case "$op" in
			NOT)	res=$(( (~num) & mask )) ;;
			1COMP)	res=$(( (~num) & mask )) ;;
			2COMP)	res=$(twos_comp "$num") ;;
			POPCNT)	res=$(popcount "$(twos_comp "$num")") ;;
			BSWAP)	res=$(bswap "$num") ;;
			*)	error_exit "Unknown unary operator '$op'" ;;
		esac
		[[ $QUIET -eq 0 && $VERBOSE -eq 1 ]] && print_unary_verbose "$num_raw" "$op" "$num" "$res"

	elif [[ $len -eq 3 ]]; then
		local a_raw="${args[0]}" op="${args[1]^^}" b_raw="${args[2]}"
		local a=$(parse_to_dec "$a_raw") b=$(parse_to_dec "$b_raw") symbol="?"

		case "$op" in
			ADD)	res=$(( a + b )); symbol="+" ;;
			SUB)	res=$(( a - b )); symbol="-" ;;
			MUL)	res=$(( a * b )); symbol="*" ;;
			DIV)	[[ $b -eq 0 ]] && error_exit "Division By Zero."; res=$(( a / b )); symbol="/" ;;
			AND)	res=$(( a & b )); symbol="&" ;;
			OR)	res=$(( a | b )); symbol="|" ;;
			XOR)	res=$(( a ^ b )); symbol="^" ;;
			NAND)	res=$(( ~(a & b) )); symbol="~&" ;;
			NOR)	res=$(( ~(a | b) )); symbol="~|" ;;
			LSHIFT)	res=$(x_shift "$a" "$b" "LSHIFT") symbol="<<" ;;
			RSHIFT)	res=$(x_shift "$a" "$b" "RSHIFT") symbol=">>" ;;
			ROL)	res=$(x_ro "$a" "$b" "ROL"); symbol="<|" ;;
			ROR)	res=$(x_ro "$a" "$b" "ROR"); symbol="|>" ;;
			*)	error_exit "Unsupported operator '$op'" ;;
		esac

		if [[ $QUIET -eq 0 && $VERBOSE -eq 1 ]]; then
			if [[ "$op" == "RSHIFT" || "$op" == "LSHIFT" || "$op" == "ROR" || "$op" == "ROL" ]]; then
				local n_res=$(( res & mask ))
				printf "%-14s= %b\n" "num" "${CYAN}$(dec_to_bin "$(twos_comp "$a")" "$WIDTH")${RESET} (${a})"
				printf "%-14s %b\n" "" "${BOLD}${symbol} ${b}${RESET}"
				echo -e ".................................."
				printf "%-14s= %b\n" "ans" "${GREEN}$(dec_to_bin "$n_res" "$WIDTH")${RESET}"
				printf "%-14s= %b\n" "ans_dec:" "${GREEN}${res}${RESET}"
			else
				print_binary_add "$a" "$b" "$res" "$mask" "$op" "$symbol"
			fi

			exit 0
		fi
	fi

	format_output "$res"
}

process_input() {
	local args=()

	while [[ $# -gt 0 ]]; do
		case "$1" in
			-f|--from)		FROM_BASE="$2"; shift 2 ;;
			-t|--to)		TO_BASE="$2"; shift 2 ;;
			-w|--width)		WIDTH="$2"; shift 2 ;;
			--prec)			PRECISION="$2"; shift 2 ;;
			-q|--quiet)		QUIET=1; VERBOSE=0; shift ;;
			-i|--interactive)	INTERACTIVE=1; shift ;;
			-h|--help)		usage; exit 0 ;;
			*)			args+=("$1"); shift ;;
		esac
	done

	if [[ ${#args[@]} -eq 0 && $INTERACTIVE -eq 0 ]]; then
		if [[ ! -t 0 ]]; then
			while IFS= read -r line || [[ -n "$line" ]]; do
				for word in $line; do args+=("$word"); done
			done
		else
			usage; exit 0
		fi
	fi

	[[ ${#args[@]} -eq 0 && $INTERACTIVE -eq 0 ]] && usage
	
	if [[ $QUIET -eq 1 ]]; then
		BOLD="" GREEN="" CYAN="" YELLOW="" RED="" RESET=""
	fi

	if [[ ${#args[@]} -gt 0 && "${args[0]}" =~ $rational_re ]]; then
		int_frac_sep "${args[0]}"
		exit 0
	else
		[[ "${args[0]}" =~ $neg_rational_re ]] && error_exit "cannot perform fractional operation with negatives"
	fi

	if [[ ${#args[@]} -gt 0 ]]; then
		evaluate_math "${args[@]}"
	fi
}

start_repl() {
	echo -e "${BOLD}bitcalc REPL${RESET} (Type 'exit' or ':q' to quit, 'clear' to clear and 'help' for man page)"
	set -o history
	local PROMP=$'\001\033[36m\002bitcalc> \001\033[0m\002'
	while true; do
		if ! read -e -p "$PROMP" line || [[ "$line" == "exit" || "$line" == ":q" ]]; then
			echo ""
			break
		elif [[ "$line" == "clear" ]]; then
			clear
			continue
		elif [[ "$line" == "help" ]]; then
			usage
			continue
		fi
		[[ -z "$line" ]] && continue

		history -s -- "$line"

		( process_input $line ) || true
	done

	set +o history
}

if [[ "$*" == *"-i"* || "$*" == *"--interactive"* ]]; then
	start_repl
else
	process_input "$@"
fi


